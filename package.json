{
  "name": "solveai",
  "displayName": "SolveAI — Local AI Code Solver",
  "description": "Solve coding questions directly inside VS Code using a local Ollama LLM. Select or type a question, click Solve, and replace it with the generated answer.",
  "version": "0.1.3",
  "publisher": "rizzzuu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "local-ai",
    "ollama",
    "coding",
    "code-generator",
    "code-fixer",
    "developer-tools",
    "offline",
    "programming",
    "vscode"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:solveai.solve",
    "onCommand:solveai.fix",
    "onCommand:solveai.explain",
    "onCommand:solveai.checkConnection",
    "onCommand:solveai.selectModel",
    "onCommand:solveai.openSettings"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suryaprabhaz/solveai.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "solveai.solve",
        "title": "Solve with AI",
        "category": "SolveAI"
      },
      {
        "command": "solveai.fix",
        "title": "Fix with AI",
        "category": "SolveAI"
      },
      {
        "command": "solveai.explain",
        "title": "Explain with AI",
        "category": "SolveAI"
      },
      {
        "command": "solveai.checkConnection",
        "title": "Check AI Connection",
        "category": "SolveAI"
      },
      {
        "command": "solveai.selectModel",
        "title": "Select AI Model",
        "category": "SolveAI"
      },
      {
        "command": "solveai.openSettings",
        "title": "Open SolveAI Settings",
        "category": "SolveAI"
      }
    ],
    "keybindings": [
      {
        "command": "solveai.solve",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "solveai.fix",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "solveai.solve",
          "when": "editorTextFocus",
          "group": "solveai@1"
        },
        {
          "command": "solveai.fix",
          "when": "editorTextFocus && editorHasSelection",
          "group": "solveai@2"
        },
        {
          "command": "solveai.explain",
          "when": "editorTextFocus && editorHasSelection",
          "group": "solveai@3"
        }
      ]
    },
    "configuration": {
      "title": "SolveAI",
      "properties": {
        "solveai.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server base URL. For LAN use, set to your laptop IP, e.g. http://192.168.1.10:11434"
        },
        "solveai.ollama.model": {
          "type": "string",
          "default": "qwen3:8b",
          "description": "Ollama model to use for code generation."
        },
        "solveai.ollama.timeout": {
          "type": "number",
          "default": 120000,
          "description": "Request timeout in milliseconds."
        },
        "solveai.ollama.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key sent as Authorization header."
        },
        "solveai.ollama.autoApply": {
          "type": "boolean",
          "default": false,
          "description": "Auto-apply AI answer without preview prompt."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "mocha": "^12.0.3",
    "typescript": "^5.3.0"
  }
}
